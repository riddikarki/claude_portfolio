# Copy this file to .env and fill it in. NEVER commit .env to git.

# --- Claude authentication (choose ONE) -------------------------------
# Max plan (recommended): on your laptop run  `claude setup-token`,
# log in with your Max account, paste the sk-ant-oat01-... token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Pay-per-token alternative. LEAVE EMPTY when using the Max token above —
# if both are set, the API key silently wins and you get billed per token.
# ANTHROPIC_API_KEY=

# --- Models ------------------------------------------------------------
# Main (CEO) model: sonnet | haiku | opus, or a full model id.
PORTFOLIO_MODEL=sonnet
# Specialists: inherit (same as CEO) | haiku | sonnet | opus
PORTFOLIO_SPECIALIST_MODEL=inherit

# --- Web console -------------------------------------------------------
# Any password you choose. The chat page asks for it once per browser.
PORTFOLIO_UI_KEY=
PORT=8080

# --- Google tools (same flags as the ADK version) ----------------------
# Turn a flag on only when that API is enabled in Google Cloud Console.
# After changing flags: DELETE token.json and re-run once to re-consent.
ADK_GOOGLE_GMAIL=true
ADK_GOOGLE_CALENDAR=true
ADK_GOOGLE_TASKS=true
ADK_GOOGLE_SHEETS=true
ADK_GOOGLE_DOCS=true
ADK_GOOGLE_SLIDES=true
